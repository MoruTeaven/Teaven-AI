# Teaven AI Gateway 自建 .env —— 服务器 /opt/apps/teaven-ai/.env 权限 600
# 通过 start.sh 的 node --env-file 注入。

PORT=3010

# --- 数据库（teavenai_db，已建并导入生产数据）---
DATABASE_URL=postgresql://teavenai_user:CHANGE_ME@pg-primary.chenyande.com:6432/teavenai_db

# --- S3（CF R2 S3 兼容直连，按爱生图决策不建 MinIO）---
S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=teaven-ai
S3_REGION=auto

# --- 业务配置（从 CF Worker Secrets 迁移）---
ADMIN_TOKEN=CHANGE_ME
USER_CENTER_TOKEN=CHANGE_ME
DEV_API_KEY=CHANGE_ME
PROVIDER_SECRET_ALLOWLIST=OPENAI_COMPATIBLE_API_KEY,OPENAI_API_KEY,SILICONFLOW_API_KEY,INTERNAL_LLM_TOKEN,MOARK_API_KEY,CLOUDFLARE_API_TOKEN,GITEE_AI_API_KEY
ALLOW_INLINE_PROVIDER_CREDENTIALS=true
OPENAI_COMPATIBLE_API_KEY=CHANGE_ME
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_DEFAULT_MODEL=gpt-4o-mini
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
CLOUDFLARE_API_TOKEN=CHANGE_ME
FILES_PUBLIC_BASE_URL=https://CHANGE_ME